generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  OWNER
}

enum ConnectionKind {
  DRIVE
  YOUTUBE
}

enum ConnectionStatus {
  ACTIVE
  EXPIRED
  ERRORED
}

enum PipelineMode {
  AUTO
  MANUAL_APPROVAL
}

enum PipelineStatus {
  ENABLED
  DISABLED
  ERRORED
}

enum PrivacyStatus {
  UNLISTED
  PUBLIC
}

enum QueueStatus {
  DETECTED
  NEEDS_ROUTING
  NEEDS_APPROVAL
  UPLOADING
  UPLOADED
  FAILED
  SKIPPED
  EXTERNALLY_HANDLED
}

enum FailureReason {
  QUOTA_EXCEEDED
  AUTH_REVOKED
  PLAYLIST_DELETED
  FILE_NOT_FOUND
  FILE_TOO_LARGE
  NOT_VIDEO
  RATE_LIMITED
  NETWORK_TIMEOUT
  VALIDATION_ERROR
  UNKNOWN
}

model User {
  id            String            @id @default(cuid())
  email         String            @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          Role              @default(USER)
  timezone      String            @default("UTC")
  disabledAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  accounts      Account[]
  sessions      Session[]
  apiKeys       ApiKey[]
  connections   OAuthConnection[]
  pipelines     Pipeline[]
  queueItems    QueueItem[]
  activityLogs  ActivityLogEntry[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ApiKey {
  id            String    @id @default(cuid())
  userId        String
  name          String
  keyHash       String    @unique
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OAuthConnection {
  id                  String            @id @default(cuid())
  userId              String
  kind                ConnectionKind
  label               String
  accountEmail        String
  channelId           String?
  channelName         String?
  channelHandle       String?
  encryptedAccessToken  String?
  encryptedRefreshToken String
  expiresAt           DateTime?
  scopes              String[]
  status              ConnectionStatus  @default(ACTIVE)
  errorMessage        String?
  connectedAt         DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  drivePipelines      Pipeline[]        @relation("DriveConnection")
  youtubePipelines    Pipeline[]        @relation("YouTubeConnection")

  @@index([userId, kind, status])
}

model Pipeline {
  id                         String            @id @default(cuid())
  userId                     String
  name                       String
  driveConnectionId          String
  youtubeConnectionId        String
  sourceFolderId             String
  sourceFolderName           String
  destinationChannelName     String
  mode                       PipelineMode      @default(AUTO)
  status                     PipelineStatus    @default(DISABLED)
  privacyStatus              PrivacyStatus     @default(UNLISTED)
  pollingIntervalMinutes     Int               @default(15)
  processedFromTime          DateTime?
  lastDetectionAt            DateTime?
  defaultTitleTemplate       String
  defaultDescriptionTemplate String
  errorMessage               String?
  archivedAt                 DateTime?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  user                       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  driveConnection            OAuthConnection   @relation("DriveConnection", fields: [driveConnectionId], references: [id])
  youtubeConnection          OAuthConnection   @relation("YouTubeConnection", fields: [youtubeConnectionId], references: [id])
  rules                      Rule[]
  queueItems                 QueueItem[]

  @@index([userId, status])
  @@index([userId, archivedAt])
  @@index([sourceFolderId])
}

model Rule {
  id                          String    @id @default(cuid())
  pipelineId                  String
  name                        String
  priority                    Int
  conditionTree               Json
  youtubePlaylistId           String
  youtubePlaylistName         String
  titleTemplateOverride       String?
  descriptionTemplateOverride String?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  pipeline                    Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@unique([pipelineId, priority])
  @@index([pipelineId])
}

model QueueItem {
  id                    String             @id @default(cuid())
  userId                String
  pipelineId            String
  driveFileId           String
  filename              String
  mimeType              String
  sizeBytes             BigInt?
  driveCreatedTime      DateTime
  detectedAt            DateTime           @default(now())
  status                QueueStatus
  previousStatus        QueueStatus?
  matchedRuleId         String?
  matchedRuleName       String?
  intendedPlaylistId    String?
  intendedPlaylistName  String?
  renderedTitle         String?
  renderedDescription   String?
  ruleEvaluationTrace   Json?
  youtubeVideoId        String?
  youtubePlaylistId     String?
  youtubeUrl            String?
  uploadedAt            DateTime?
  failureReason         FailureReason?
  lastError             String?
  lastActionAt          DateTime           @default(now())
  isSeedData            Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  pipeline              Pipeline           @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  attempts              UploadAttempt[]
  activityLog           ActivityLogEntry[]

  @@unique([pipelineId, driveFileId])
  @@index([userId, status, detectedAt])
  @@index([pipelineId, status])
}

model UploadAttempt {
  id             String         @id @default(cuid())
  queueItemId    String
  attemptNumber  Int
  startedAt      DateTime       @default(now())
  finishedAt     DateTime?
  success        Boolean        @default(false)
  failureReason  FailureReason?
  rawError       String?
  youtubeVideoId String?
  queueItem      QueueItem      @relation(fields: [queueItemId], references: [id], onDelete: Cascade)

  @@unique([queueItemId, attemptNumber])
}

model ActivityLogEntry {
  id          String    @id @default(cuid())
  userId      String?
  queueItemId String
  actorType   String
  message     String
  metadata    Json?
  createdAt   DateTime  @default(now())
  user        User?      @relation(fields: [userId], references: [id])
  queueItem   QueueItem @relation(fields: [queueItemId], references: [id], onDelete: Cascade)

  @@index([queueItemId, createdAt])
}
