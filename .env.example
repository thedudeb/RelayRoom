# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
AUTH_SECRET=replace-with-a-long-random-secret
INITIAL_ADMIN_EMAIL=owner@example.com
AUTH_ALLOWED_EMAILS=
# Optional: comma-separated Google Workspace domains allowed to sign in.
# Example: geniusventuresinc.com,geniusinnovationlab.com
AUTH_ALLOWED_DOMAINS=
# Dev-only: when AUTH_ALLOWED_EMAILS and AUTH_ALLOWED_DOMAINS are empty, set
# AUTH_ALLOW_ANY=true to permit any Google account to sign in. Production fails
# closed regardless.
AUTH_ALLOW_ANY=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/relayroom
TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key
# Optional: enables HMAC-SHA256 hashing of API keys with an env-scoped pepper.
# Existing SHA-256-hashed keys keep working; new keys hash as h1:<hmac>.
API_KEY_PEPPER=
# Defaults to paused unless explicitly set to false. Set false only when you
# intend to spend Drive/YouTube quota.
GOOGLE_INTEGRATIONS_DISABLED=true

# Google sign-in OAuth
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=

# Drive connection OAuth
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/oauth/drive/callback
GOOGLE_PICKER_API_KEY=
GOOGLE_PICKER_APP_ID=

# YouTube connection OAuth
GOOGLE_YOUTUBE_CLIENT_ID=
GOOGLE_YOUTUBE_CLIENT_SECRET=
GOOGLE_YOUTUBE_REDIRECT_URI=http://localhost:3000/api/oauth/youtube/callback

# Detection
POLLING_INTERVAL_MINUTES=15
DETECTION_WEBHOOK_SECRET=
CRON_SECRET=
# Optional: override the URL Google should POST Drive push notifications to.
# Defaults to ${request origin}/api/webhooks/drive. Set this when the deployed
# domain that Vercel reports differs from the one Google should call.
DRIVE_WATCH_WEBHOOK_URL=
